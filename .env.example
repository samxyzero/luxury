# Public site URL (used for SEO metadata, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# GitHub OAuth App credentials, used to power the /admin content editor (Decap CMS).
# See README.md "Setting up the content editor" for how to create these.
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=

# Resend API key, used to send contact form submissions by email.
# Get a free key at https://resend.com — the contact form works without it,
# but will show visitors a "please email us directly" fallback message.
RESEND_API_KEY=

# Email address that receives contact form submissions.
# Defaults to the "email" field in content/site.json if not set.
CONTACT_NOTIFY_EMAIL=
