# Public site URL (used for SEO metadata, sitemap, robots.txt)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Neon (Postgres) connection string. Get this from your Neon project dashboard
# under Connection Details. A pooled connection string works fine.
DATABASE_URL=

# Random secret used to sign admin session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Resend API key, used to send contact form submissions by email.
# Get a free key at https://resend.com — the contact form works without it,
# but will show visitors a "please email us directly" fallback message.
RESEND_API_KEY=

# Email address that receives contact form submissions.
# Defaults to the "email" field in site settings if not set.
CONTACT_NOTIFY_EMAIL=

# Cloudinary — used by the admin panel's image upload fields (hero/about
# background, product photos, gallery photos). Get these from your
# Cloudinary dashboard under Settings > Access Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only needed once, when running `npm run db:seed` to create the first admin
# login — set these as one-off shell env vars for that single command, not
# here, then remove them. See README.md "Local development".
# ADMIN_EMAIL=
# ADMIN_SEED_PASSWORD=
